# This XAMPP setup has no vhost pointed at /public, so this project root
# itself is web-reachable. Block secrets and dotfiles at this level;
# app/, database/, storage/, languages/, views/, modules/ each carry their
# own deny-all .htaccess as well (defense in depth).

<FilesMatch "^(\.env.*|.*\.sql|.*\.md|composer\.(json|lock))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
